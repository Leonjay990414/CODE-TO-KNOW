# CODE TO KNOW (碼上學) 後端環境變數範本
# 切勿將真實金鑰或密碼提交至 Git 版本控制

NODE_ENV=development
PORT=4000

# 資料庫連線字串 (PostgreSQL 16)
DATABASE_URL="postgresql://codetoknow:your_secure_postgres_password_here@127.0.0.1:5432/code_to_know?schema=public"

# 安全與 Session 密鑰
SESSION_SECRET="your_random_session_secret_min_32_characters_long_12345"
COOKIE_SECRET="your_random_cookie_secret_min_32_characters_long_67890"
JWT_SECRET="your_random_jwt_secret_min_32_characters_long_abcde"
BCRYPT_ROUNDS=12

# 前端網址與 CORS
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN="localhost"

# 電子郵件發送設定 (尚未啟用正式 SMTP，留空時於控制台安全輸出 Token)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="noreply@codetoknow.edu"
