# CODE TO KNOW (碼上學) 根目錄環境變數範本
# 複製此檔案為 .env 並填入本機環境設定值

# PostgreSQL 容器配置
POSTGRES_USER=codetoknow
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=code_to_know
POSTGRES_PORT=5432

# 後端服務設定
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://codetoknow:your_secure_postgres_password_here@127.0.0.1:5432/code_to_know?schema=public"

# 前端位置
FRONTEND_URL="http://localhost:3000"

# 安全憑證密鑰（請至少配置 32 個字元之隨機字串）
SESSION_SECRET="your_random_session_secret_min_32_characters_long_12345"
COOKIE_SECRET="your_random_cookie_secret_min_32_characters_long_67890"
JWT_SECRET="your_random_jwt_secret_min_32_characters_long_abcde"
