# CODE TO KNOW (碼上學) 前端環境變數配置範本
# ==============================================================================
# 模式說明：
#
# 1. 本機開發模式 (Development Mode - 預設)：
#    若未特別指定，本機 Vite 開發伺服器預設連向本機後端 API。
VITE_API_URL="http://localhost:4000/api"
VITE_DEMO_MODE=false

# 2. 靜態預覽展示模式 (Static Demo Mode - 如 GitHub Pages 或靜態預覽站台)：
#    開啟後，前端所有登入、註冊、班級管理等功能皆在瀏覽器端使用 sessionStorage 純前端模擬，
#    不發送任何外部網路請求，亦不會連向使用者本機 localhost。
# VITE_DEMO_MODE=true

# 3. 雲端正式營運模式 (Production Deployment - 如 Render Web Service)：
#    正式環境嚴格要求配置合法公開的後端 API 端點。
#    【安全防護】：若正式建置時未配置 VITE_API_URL 且未啟用 VITE_DEMO_MODE，
#    系統將自動攔截網路呼叫並提示配置錯誤，嚴格禁止默默 fallback 呼叫訪客本機 localhost:4000。
# VITE_API_URL="https://code-to-know-api.onrender.com/api"
# VITE_DEMO_MODE=false
